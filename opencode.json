{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "unreal-mcp": {
      "type": "local",
      "command": [
        "uv",
        "--directory",
        "D:/mcp-servers/unreal-mcp/mcp-server",
        "run",
        "unrealmcp"
      ],
      "enabled": true
    },
    "ghidra": {
      "type": "local",
      "command": [
        "uv",
        "--directory",
        "D:/mcp-servers/ghidra-mcp",
        "run",
        "bridge-mcp-ghidra",
        "--transport",
        "stdio"
      ],
      "enabled": true,
      "env": {
        "GHIDRA_MCP_URL": "http://127.0.0.1:8089",
        "GHIDRA_DEBUGGER_URL": "http://127.0.0.1:8099",
        "PYTHONIOENCODING": "utf-8"
      }
    }
  }
}
