{
  "name": "apb-content-studio-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:static": "tsc --noEmit && vite build --mode static",
    "preview": "vite preview",
    "e2e": "playwright test",
    "e2e:static": "playwright test --config playwright.static.config.ts",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.169.0",
    "@react-three/fiber": "8.17.10",
    "@react-three/drei": "9.114.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.169.0",
    "@vitejs/plugin-react": "4.3.3",
    "typescript": "5.6.3",
    "vite": "5.4.10"
  }
}
